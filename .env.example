# Clara Finance — finanças pessoais

PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Opcional: segredo próprio para validar webhooks (diferente do Client Secret).
# Gere com: node --env-file-if-exists=.env.local scripts/pluggy-webhook.cjs setup
PLUGGY_WEBHOOK_SECRET=

# Logo.dev (opcional): logos de bancos, estabelecimentos e empresas no painel.
# Obtenha a Publishable key (pk_) em https://www.logo.dev/dashboard/api-keys
# Esta chave fica visível no navegador. Não use a Secret key (sk_) nem segredos da Pluggy.
# Deixe vazio para usar somente os ícones e logos locais disponíveis.
# Reinicie npm run dev após alterar; em produção, refaça npm run build.
# Se restringir os domínios, permita os hosts usados (localhost, 127.0.0.1 etc.), sem porta.
# Instruções completas na seção "Configurar o Logo.dev" do README.
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=

# Opcional: caminho absoluto para seu banco local.
# DATABASE_PATH=/caminho/privado/finances.sqlite
# Em Vercel o padrão é /tmp/clara-finances.sqlite (efêmero; seed demo na cold start).

# Preview público: abre em Dados fictícios por padrão (localStorage ainda pode mudar).
# NEXT_PUBLIC_DEMO_DEFAULT=true

# Acesso sem login pela rede local. Ative apenas em uma rede confiavel.
ALLOW_LAN_ACCESS=false

# Preview público (ex.: Vercel). Libera a API fora de localhost; sem login.
# ALLOW_PUBLIC_PREVIEW=true

# Voz sintética Coqui XTTS no modo voz (opcional; padrão desligado).
# Sem isso o modo voz usa só o speechSynthesis do navegador.
# Detalhes: seção "Voz sintética (opcional)" do README e services/clara-xtts/README.md
NEXT_PUBLIC_CLARA_XTTS=false
CLARA_XTTS_URL=http://127.0.0.1:8020/tts
# true = npm run dev também sobe o sidecar XTTS (só faz sentido com NEXT_PUBLIC_CLARA_XTTS=true)
CLARA_XTTS_WITH_DEV=false
# CLARA_XTTS_SCRATCH=D:\clara-xtts-scratch
# CLARA_XTTS_PORT=8020
