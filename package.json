{
  "name": "clara-finance",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/serve.cjs dev",
    "dev:voice": "node scripts/with-xtts.cjs dev",
    "build": "next build",
    "start": "node scripts/serve.cjs start",
    "start:voice": "node scripts/with-xtts.cjs start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup.cjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts docs *.ts *.mjs *.json *.md",
    "security:check": "node scripts/check-private-data.cjs --all",
    "prepare": "node scripts/install-hooks.cjs"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.1",
    "@ui-sdk/react": "0.1.0-beta.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.9.2",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "pixelarticons": "^2.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "skullet": "^0.0.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "29.1.1",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@ts-morph/common": {
      "minimatch": "^11.0.1"
    }
  }
}
